{% extends 'base.html.twig' %}

{% block title %}{{ product.id }}: {{ product.name }}{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('product_index') }}">Index of Cereals</a>
            </li>
            <li class="breadcrumb-item active">{{ product.name }}</li>
        </ol>
    </nav>
{% endblock %}

{% block body %}
<div class="row g-3 g-md-4 mb-4 align-items-stretch">
    <div class="col-md-5">
        <div class="surface-card p-3 h-100">
            {% if image is not null %}
                <img
                    src="data:{{ image.mimeType }};base64,{{ image_base64 }}"
                    alt="{{ product.name }}"
                    class="img-fluid rounded-3 w-100"
                >
            {% else %}
                <div class="d-flex justify-content-center align-items-center rounded-3 h-100 py-5" style="background: #222f3c; border: 1px dashed #4f647a; min-height: 260px;">
                    <p class="text-body-secondary mb-0">No image uploaded yet</p>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="col-md-7">
        <div class="surface-card p-3 p-md-4 h-100">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <h2 class="h4 mb-1">{{ product.name }}</h2>
                    <div class="d-flex gap-1 flex-wrap">
                        <span class="meta-pill">{{ product.mfr.name }} ({{ product.mfr.shorthand }})</span>
                        <span class="meta-pill">{{ product.type.name }}</span>
                        <span class="meta-pill">Shelf {{ product.shelf }}</span>
                    </div>
                </div>
            </div>

            <div class="nutrition-grid mb-3">
                <div class="nutrition-box">
                    <div class="label">Calories</div>
                    <div class="value">{{ product.calories }}</div>
                </div>
                <div class="nutrition-box">
                    <div class="label">Sugars</div>
                    <div class="value">{{ product.sugars }} g</div>
                </div>
                <div class="nutrition-box">
                    <div class="label">Protein</div>
                    <div class="value">{{ product.protein }} g</div>
                </div>
                <div class="nutrition-box">
                    <div class="label">Fiber</div>
                    <div class="value">{{ product.fiber }} g</div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a href="{{ path('single_product_edit', {id: product.id}) }}" class="btn btn-secondary">Edit</a>
                <a href="{{ path('single_product_delete', {id: product.id}) }}" class="btn btn-danger-soft">Delete</a>
            </div>
        </div>
    </div>
</div>

<div class="surface-card p-3 p-md-4">
    <h3 class="h5 mb-3">Nutrition Details</h3>
    <table class="table table-striped table-hover mb-0">
        <tbody>
            <tr>
                <th scope="row">Name</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th scope="row">Manufacturer</th>
                <td>{{ product.mfr.name }} ({{ product.mfr.shorthand }})</td>
            </tr>
            <tr>
                <th scope="row">Type</th>
                <td>{{ product.type.name }}</td>
            </tr>
            <tr>
                <th scope="row">Calories</th>
                <td>{{ product.calories }}</td>
            </tr>
            <tr>
                <th scope="row">Protein</th>
                <td>{{ product.protein }}</td>
            </tr>
            <tr>
                <th scope="row">Fat</th>
                <td>{{ product.fat }}</td>
            </tr>
            <tr>
                <th scope="row">Sodium</th>
                <td>{{ product.sodium }}</td>
            </tr>
            <tr>
                <th scope="row">Fiber</th>
                <td>{{ product.fiber }}</td>
            </tr>
            <tr>
                <th scope="row">Carbs</th>
                <td>{{ product.carbo }}</td>
            </tr>
            <tr>
                <th scope="row">Sugars</th>
                <td>{{ product.sugars }}</td>
            </tr>
            <tr>
                <th scope="row">Potassium</th>
                <td>{{ product.potass }}</td>
            </tr>
            <tr>
                <th scope="row">Vitamins</th>
                <td>{{ product.vitamins }}</td>
            </tr>
            <tr>
                <th scope="row">Shelf</th>
                <td>{{ product.shelf }}</td>
            </tr>
            <tr>
                <th scope="row">Weight</th>
                <td>{{ product.weight }}</td>
            </tr>
            <tr>
                <th scope="row">Cups</th>
                <td>{{ product.cups }}</td>
            </tr>
        </tbody>
    </table>
</div>

{% endblock %}