{% extends 'base.html.twig' %}

{% set isEdit = product is defined and product.id is defined and product.id %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('product_index') }}">Index of cereals</a>
            </li>
            {% if isEdit %}
                <li class="breadcrumb-item">
                    <a href="{{ path('single_product_show', {'id': product.id}) }}">{{ product.name }}</a>
                </li>
                <li class="breadcrumb-item active">Edit</li>
            {% else %}
                <li class="breadcrumb-item active">Create</li>
            {% endif %}
        </ol>
    </nav>
{% endblock %}

{% block title %}{% if isEdit %}Editing {{ product.id }}: {{ product.name }}{% else %}Create Cereal{% endif %}{% endblock %}

{% block body %}
<form method="post" action="{{ path('product_save') }}" enctype="multipart/form-data">
    <input type="hidden" name="id" value="{{ isEdit ? product.id : '' }}">
    <div class="row">
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="name" type="text" class="form-control" id="name-input" value="{{ isEdit ? product.name : '' }}" placeholder="Name" required minlength="2" maxlength="255">
                <label for="name-input" class="form-label">Name</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <select name="mfr" class="form-select" id="mfr-input" placeholder="Manufacturer" required>
                    {% for mfr in mfrs %}
                        <option value="{{ mfr.id }}" {% if isEdit and product.mfr and mfr.id == product.mfr.id %}selected{% endif %}>{{ mfr.name }} ({{ mfr.shorthand }})</option>
                    {% endfor %}
                </select>
                <label for="mfr-input" class="form-label">Manufacturer</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <select name="type" class="form-select" id="type-input" placeholder="Type" required>
                    {% for type in types %}
                        <option value="{{ type.id }}" {% if isEdit and product.type and type.id == product.type.id %}selected{% endif %}>{{ type.name }}</option>
                    {% endfor %}
                </select>
                <label for="type-input" class="form-label">Type</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="calories" type="number" class="form-control" id="calories-input" value="{{ isEdit ? product.calories : '' }}" placeholder="Calories" required min="0" step="1">
                <label for="calories-input" class="form-label">Calories</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="protein" type="number" class="form-control" id="protein-input" value="{{ isEdit ? product.protein : '' }}" placeholder="Protein" required min="0" step="1">
                <label for="protein-input" class="form-label">Protein</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="fat" type="number" class="form-control" id="fat-input" value="{{ isEdit ? product.fat : '' }}" placeholder="Fat" required min="0" step="1">
                <label for="fat-input" class="form-label">Fat</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="sodium" type="number" class="form-control" id="sodium-input" value="{{ isEdit ? product.sodium : '' }}" placeholder="Sodium" required min="0" step="1">
                <label for="sodium-input" class="form-label">Sodium</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="fiber" type="number" class="form-control" id="fiber-input" value="{{ isEdit ? product.fiber : '' }}" placeholder="Fiber" required min="0" step="0.1">
                <label for="fiber-input" class="form-label">Fiber</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="carbo" type="number" class="form-control" id="carbo-input" value="{{ isEdit ? product.carbo : '' }}" placeholder="Carbs" required min="0" step="0.1">
                <label for="carbo-input" class="form-label">Carbs</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="sugars" type="number" class="form-control" id="sugars-input" value="{{ isEdit ? product.sugars : '' }}" placeholder="Sugars" required min="0" step="1">
                <label for="sugars-input" class="form-label">Sugars</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="potass" type="number" class="form-control" id="potass-input" value="{{ isEdit ? product.potass : '' }}" placeholder="Potassium" min="0" step="1">
                <label for="potass-input" class="form-label">Potassium</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="vitamins" type="number" class="form-control" id="vitamins-input" value="{{ isEdit ? product.vitamins : '' }}" placeholder="Vitamins" required min="0" step="1">
                <label for="vitamins-input" class="form-label">Vitamins</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="shelf" type="number" class="form-control" id="shelf-input" value="{{ isEdit ? product.shelf : '' }}" placeholder="Shelf" required min="0" step="1">
                <label for="shelf-input" class="form-label">Shelf</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="weight" type="number" class="form-control" id="weight-input" value="{{ isEdit ? product.weight : '' }}" placeholder="Weight" required min="0" step="0.1">
                <label for="weight-input" class="form-label">Weight</label>
            </div>
        </div>
        <div class="col">
            <div class="mb-3 form-floating">
                <input name="cups" type="number" class="form-control" id="cups-input" value="{{ isEdit ? product.cups : '' }}" placeholder="Cups" required min="0" step="0.1">
                <label for="cups-input" class="form-label">Cups</label>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label for="image-input" class="form-label">Product image</label>
                <input name="image" type="file" class="form-control" id="image-input" accept="image/*">
                <div class="form-text">{{ isEdit ? 'Upload a new file to replace the current image.' : 'Optional. Upload an image for this cereal.' }}</div>
            </div>
        </div>
    </div>
    <div class="btn-group">
        <button type="submit" class="btn btn-success">{{ isEdit ? 'Save edits' : 'Create cereal' }}</button>
        {% if isEdit %}
            <a href="{{ path('single_product_show', {id: product.id}) }}" class="btn btn-secondary">See product</a>
            <a href="{{ path('single_product_delete', {id: product.id}) }}" class="btn btn-danger">Delete</a>
        {% endif %}
    </div>
</form>
{% endblock %}